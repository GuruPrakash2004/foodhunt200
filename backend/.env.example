# --- Required ---
NVIDIA_API_KEY=  # https://build.nvidia.com (Get API Key): free preview models


# --- Swiggy (from Swiggy Builders Club after your access is approved) ---
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=
# SWIGGY_MCP_URL=https://mcp.swiggy.com/food   # Food only; redirect URI http://localhost:8765/callback

# --- Zomato (usually no client id needed; leave blank to use dynamic registration) ---
ZOMATO_CLIENT_ID=
# ZOMATO_MCP_URL=https://mcp-server.zomato.com/mcp

# --- Hunt defaults ---
FOODHUNT_BUDGET=200
FOODHUNT_DIET=veg
FOODHUNT_ADDRESS=Home
FOODHUNT_QUERIES=thali, biryani, rice bowl, meals, dosa, combo, rolls
FOODHUNT_MAX_TURNS=60

# --- Speed and resilience (optional) ---
# FOODHUNT_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # tried first; leave unset for the built-in list of free models that call tools
# FOODHUNT_FALLBACK_MODELS=minimaxai/minimax-m3.1-flash,openai/gpt-oss-20b   # tried next, before every other chat model on your key
# FOODHUNT_MODEL_TIMEOUT=30        # seconds before a slow model call is abandoned and the next model is tried

# FOODHUNT_NVIDIA_MAX_INPUT_TOKENS=24000   # how much of the hunt so far is sent to the model
# FOODHUNT_NVIDIA_TOOL_CHARS=4000          # tool results are clipped to this
    
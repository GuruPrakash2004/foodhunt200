# --- Required ---
GOOGLE_API_KEY=  # https://aistudio.google.com/apikey

# --- Swiggy (from Swiggy Builders Club after your access is approved) ---
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=
# SWIGGY_MCP_URL=https://mcp.swiggy.com/food   # Food only; redirect URI http://localhost:8765/callback

# --- Zomato (usually no client id needed; leave blank to use dynamic registration) ---
ZOMATO_CLIENT_ID=
# ZOMATO_MCP_URL=https://mcp-server.zomato.com/mcp

# --- Hunt defaults ---
FOODHUNT_BUDGET=200
FOODHUNT_DIET=veg
FOODHUNT_ADDRESS=Home
FOODHUNT_QUERIES=thali, biryani, rice bowl, meals, dosa, combo, rolls
FOODHUNT_MODEL=gemini-3.8-flash
FOODHUNT_MAX_TURNS=60

# --- Speed and resilience (optional) ---
# FOODHUNT_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash   # tried in order if FOODHUNT_MODEL fails
# FOODHUNT_MODEL_TIMEOUT=40        # seconds before a slow model call is abandoned
# FOODHUNT_THINKING=low            # MINIMAL | LOW | MEDIUM | HIGH

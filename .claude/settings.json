{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(backend/.venv/bin/python -m pytest:*)",
      "Bash(cd backend && .venv/bin/python -m pytest:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(node .claude/skills/design-taste-frontend/scripts/*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/data/tokens/**)",
      "Edit(./backend/data/tokens/**)"
    ]
  }
}
